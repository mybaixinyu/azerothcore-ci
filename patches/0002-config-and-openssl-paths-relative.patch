diff --git a/src/common/Cryptography/OpenSSLCrypto.cpp b/src/common/Cryptography/OpenSSLCrypto.cpp
index a997cfe..bb341bb 100644
--- a/src/common/Cryptography/OpenSSLCrypto.cpp
+++ b/src/common/Cryptography/OpenSSLCrypto.cpp
@@ -38,10 +38,38 @@ void SetupLibrariesForWindows()
 }
 #endif
 
+#ifdef __APPLE__
+#include <cstdint>
+#include <filesystem>
+#include <mach-o/dyld.h>
+#include <string>
+
+// RC4 lives in OpenSSL 3's legacy provider, which libcrypto looks for in a
+// directory compiled into it - a Homebrew Cellar path on the build machine.
+// Load it from <program dir>/lib/ossl-modules instead, like Windows does above.
+void SetupLibrariesForMacOS()
+{
+    namespace fs = std::filesystem;
+
+    uint32_t size = 0;
+    _NSGetExecutablePath(nullptr, &size);
+    std::string buffer(size, '\0');
+    if (_NSGetExecutablePath(buffer.data(), &size) != 0)
+        return;
+
+    std::error_code ec;
+    fs::path modules = fs::weakly_canonical(fs::path(buffer.c_str()), ec).parent_path() / "lib" / "ossl-modules";
+    if (!ec && fs::exists(modules / "legacy.dylib", ec))
+        OSSL_PROVIDER_set_default_search_path(nullptr, modules.generic_string().c_str());
+}
+#endif
+
 void OpenSSLCrypto::threadsSetup()
 {
 #if AC_PLATFORM == AC_PLATFORM_WINDOWS
     SetupLibrariesForWindows();
+#elif defined(__APPLE__)
+    SetupLibrariesForMacOS();
 #endif
     LegacyProvider = OSSL_PROVIDER_load(nullptr, "legacy");
     DefaultProvider = OSSL_PROVIDER_load(nullptr, "default");
