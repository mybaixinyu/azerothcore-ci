+        // Summons made without a SummonProperties entry have no owner, so once one of them has
+        // fought (or evaded) it goes to its home position and stays there instead of following
+        // Cork again. SummonsFollow() only ran at the stops, so re-issue the follow for any
+        // summon that is out of combat and no longer following.
+        void RefollowSummons()
+        {
+            float dist = 1.0f;
+            for (uint8 i = 0; i < MAX_CARAVAN_SUMMONS; ++i)
+            {
+                if (Creature* summon = ObjectAccessor::GetCreature(*me, summons[i]))
+                {
+                    if (summon->IsAlive() && !summon->IsInCombat() &&
+                        summon->GetMotionMaster()->GetCurrentMovementGeneratorType() != FOLLOW_MOTION_TYPE)
+                    {
+                        summon->ClearUnitState(UNIT_STATE_EVADE);
+                        summon->GetMotionMaster()->Clear(false);
+                        summon->StopMoving();
+                        summon->GetMotionMaster()->MoveFollow(me, dist, M_PI, MOTION_SLOT_ACTIVE);
+                    }
+                    dist += (i == 1 ? 9.5f : 3.0f);
+                }
+            }
+        }
