+    // A unit uses a handful of the aura types, so the lists live in small blocks and a
+    // bitmask answers for the empty ones. Callers hold references across aura removal,
+    // so a list never moves and stays allocated until the unit is destroyed. A reader on
+    // another map thread sees a block entry only through the bit set after it was written.
+    class AuraEffectsByType
+    {
+    public:
+        AuraEffectsByType() = default;
+        AuraEffectsByType(AuraEffectsByType const&) = delete;
+        AuraEffectsByType& operator=(AuraEffectsByType const&) = delete;
+        ~AuraEffectsByType();
+
+        [[nodiscard]] bool Has(AuraType type) const
+        {
+            // Conditions and spell misc values pass unchecked data here
+            uint32 index = uint32(type);
+            return index < TOTAL_AURAS && ((_nonEmpty[index / 64].load(std::memory_order_acquire) >> (index % 64)) & 1);
+        }
+        [[nodiscard]] AuraEffectList const& Get(AuraType type) const { return Has(type) ? *Find(type) : _noEffects; }
+        void Add(AuraType type, AuraEffect* aurEff);
+        void Remove(AuraType type, AuraEffect* aurEff);
+
+    private:
+        static constexpr uint32 BLOCK_LISTS = 8;
+        struct Block
+        {
+            std::atomic<uint16> types[BLOCK_LISTS]{}; // type + 1, 0 when the slot is free
+            std::atomic<Block*> next{nullptr};
+            AuraEffectList lists[BLOCK_LISTS];
+        };
+
+        [[nodiscard]] AuraEffectList* Find(AuraType type) const;
+        AuraEffectList& Create(AuraType type);
+
+        inline static AuraEffectList const _noEffects;
+        std::atomic<uint64> _nonEmpty[(TOTAL_AURAS + 63) / 64]{};
+        std::atomic<Block*> _blocks{nullptr};
+    };
+
+    AuraEffectsByType m_modAuras;
