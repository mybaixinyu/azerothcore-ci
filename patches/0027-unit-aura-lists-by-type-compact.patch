+        m_modAuras.Remove(aurEff->GetAuraType(), aurEff);
+}
+
+Unit::AuraEffectsByType::~AuraEffectsByType()
+{
+    for (Block* block = _blocks.load(std::memory_order_relaxed); block;)
+    {
+        Block* next = block->next.load(std::memory_order_relaxed);
+        delete block;
+        block = next;
+    }
+}
+
+Unit::AuraEffectList* Unit::AuraEffectsByType::Find(AuraType type) const
+{
+    for (Block* block = _blocks.load(std::memory_order_relaxed); block; block = block->next.load(std::memory_order_relaxed))
+        for (uint32 i = 0; i < BLOCK_LISTS; ++i)
+            if (block->types[i].load(std::memory_order_relaxed) == type + 1)
+                return &block->lists[i];
+
+    return nullptr;
+}
+
+Unit::AuraEffectList& Unit::AuraEffectsByType::Create(AuraType type)
+{
+    std::atomic<Block*>* link = &_blocks;
+    while (Block* block = link->load(std::memory_order_relaxed))
+    {
+        for (uint32 i = 0; i < BLOCK_LISTS; ++i)
+        {
+            if (!block->types[i].load(std::memory_order_relaxed))
+            {
+                block->types[i].store(type + 1, std::memory_order_relaxed);
+                return block->lists[i];
+            }
+        }
+        link = &block->next;
+    }
+
+    Block* block = new Block();
+    block->types[0].store(type + 1, std::memory_order_relaxed);
+    link->store(block, std::memory_order_relaxed);
+    return block->lists[0];
+}
+
+void Unit::AuraEffectsByType::Add(AuraType type, AuraEffect* aurEff)
+{
+    AuraEffectList* list = Find(type);
+    if (!list)
+        list = &Create(type);
+
+    list->push_back(aurEff);
+    if (list->size() == 1)
+        _nonEmpty[type / 64].fetch_or(uint64(1) << (type % 64), std::memory_order_release);
+}
+
+void Unit::AuraEffectsByType::Remove(AuraType type, AuraEffect* aurEff)
+{
+    if (!Has(type))
+        return;
+
+    AuraEffectList* list = Find(type);
+    list->erase(std::remove(list->begin(), list->end(), aurEff), list->end());
+    if (list->empty())
+        _nonEmpty[type / 64].fetch_and(~(uint64(1) << (type % 64)), std::memory_order_relaxed);
 }
 
