 using namespace Acore;
 
@@ -173,10 +174,31 @@ void CreatureRelocationNotifier::Visit(PlayerMapType& m)
 void AIRelocationNotifier::Visit(CreatureMapType& m)
 {
     bool self = isCreature && !((Creature*)(&i_unit))->IsMoveInLineOfSightStrictlyDisabled();
+
+    // The visited cells cover a far larger square than a creature can see, and a pair out of
+    // sight still pays for every check in CanSeeOrDetect, twice. Sight adds the target's
+    // size: i_unit's is read here, 10 yards allows for the other's (121 of 24,143 models
+    // are larger), 60 is the radius ExecuteDelayedUnitAINotifyEvent asks for. Players
+    // are left out because scripts react to them at longer range.
+    float maxDistSq = 0.0f;
+    if (isCreature)
+    {
+        float maxDist = std::max(60.0f, ((Creature*)(&i_unit))->m_SightDistance + 10.0f) + i_unit.GetObjectSize();
+        maxDistSq = maxDist * maxDist;
+    }
+
     for (CreatureMapType::iterator iter = m.begin(); iter != m.end(); ++iter)
     {
         Creature* c = iter->GetSource();
 
+        // The walk chases one pointer per creature, so fetch the next one's position alongside it
+        char const* nextRef = reinterpret_cast<char const*>(iter->nocheck_next());
+        __builtin_prefetch(nextRef);
+        __builtin_prefetch(nextRef + (reinterpret_cast<char const*>(static_cast<Position const*>(c)) - reinterpret_cast<char const*>(&*iter)));
+
+        if (isCreature && c->GetExactDist2dSq(&i_unit) > maxDistSq && c->m_SightDistance <= 60.0f)
+            continue;
+
         // NOTIFY_VISIBILITY_CHANGED | NOTIFY_AI_RELOCATION does not guarantee that unit will do it itself (because distance is also checked), but screw it, it's not that important
         if (!c->isNeedNotify(NOTIFY_VISIBILITY_CHANGED | NOTIFY_AI_RELOCATION) && !c->IsMoveInLineOfSightStrictlyDisabled())
             CreatureUnitRelocationWorker(c, &i_unit);
