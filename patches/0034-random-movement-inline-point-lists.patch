+    // The points reachable from one point, in order; held inline as every creature that wanders has 13 of these
+    struct PointList
+    {
+        uint8 count = 0;
+        uint8 points[RANDOM_POINTS_NUMBER];
+
+        void Add(uint8 point) { points[count++] = point; }
+        void Erase(uint8 index)
+        {
+            std::memmove(points + index, points + index + 1, --count - index);
