+    // The event's first two 128-byte lines hold what UpdateTimer reads; most scripts have up to two
+    void PrefetchEvents() const
+    {
+        if (mEvents.empty())
+            return;
+
+        char const* events = reinterpret_cast<char const*>(mEvents.data());
+        __builtin_prefetch(events);
+        __builtin_prefetch(events + 128);
+        if (mEvents.size() > 1)
+            __builtin_prefetch(events + 256);
+    }
+
