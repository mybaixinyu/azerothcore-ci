+// Fetches each block a creature's update reads first, before its turn. Every block's address is
+// read from the block before it, so the fetches run as stages, one object nearer each time. None
+// of this changes state, and a pointer only read here is one the update itself reads next.
+static inline void PrefetchCreatureBlocks(Creature* creature)
+{
+    if (UnitAI* ai = creature->GetAI())
+        for (uint32 offset : { 0, 256, 384, 512 }) // SmartAI: vtable, event list, script state
+            __builtin_prefetch(reinterpret_cast<char const*>(ai) + offset);
+
+    __builtin_prefetch(creature->movespline);
+    __builtin_prefetch(creature->GetMotionMaster());
+
+    Unit::AuraMap const& auras = creature->GetOwnedAuras();
+    if (!auras.empty())
+        __builtin_prefetch(&*auras.begin());
+
+    Unit::VisibleAuraMap const* visibleAuras = creature->GetVisibleAuras();
+    if (!visibleAuras->empty())
+        __builtin_prefetch(&*visibleAuras->begin());
+}
+
+static inline void PrefetchCreatureTargets(Creature* creature)
+{
+    if (creature->IsAIEnabled)
+        if (UnitAI* ai = creature->GetAI())
+            ai->PrefetchForUpdate();
+
+    MotionMaster const* motionMaster = creature->GetMotionMaster();
+    if (!motionMaster->empty())
+    {
+        char const* generator = reinterpret_cast<char const*>(motionMaster->top());
+        __builtin_prefetch(generator);
+        __builtin_prefetch(generator + 128);
+    }
+
+    Unit::AuraMap const& auras = creature->GetOwnedAuras();
+    if (!auras.empty())
+    {
+        char const* aura = reinterpret_cast<char const*>(auras.begin()->second);
+        __builtin_prefetch(aura);
+        __builtin_prefetch(aura + 128);
+    }
+
+    Unit::VisibleAuraMap const* visibleAuras = creature->GetVisibleAuras();
+    if (!visibleAuras->empty())
+        __builtin_prefetch(visibleAuras->begin()->second);
+}
+
+static inline void PrefetchCreatureAuraEffects(Creature* creature)
+{
+    Unit::AuraMap const& auras = creature->GetOwnedAuras();
+    if (!auras.empty())
+        auras.begin()->second->PrefetchEffects();
+}
+
 // The list holds pointers to objects scattered across the heap, beyond hardware prefetch.
-// Offsets are the 128-byte lines of Creature that Update reads most: object header, update
-// timers, spline and AI pointers, current spells, owned auras and aura masks, visible auras,
-// motion master. A moved field only makes its prefetch useless. Two objects ahead fetches
-// the object, so one ahead can read its header for the separate block of update fields.
+// Offsets are the 128-byte lines of Creature that Update reads most: object header, position,
+// update timers, spline and AI pointers, current spells, owned auras and aura masks, visible
+// auras, motion master, unit state, script and respawn fields. A moved field only makes its
+// prefetch useless.
 static inline void PrefetchForUpdate(std::vector<WorldObject*> const& objects, uint32 i)
 {
-    if (i + 2 < objects.size())
-        for (uint32 offset : { 0, 1152, 1280, 1408, 1536, 2176, 2304 })
-            __builtin_prefetch(reinterpret_cast<char const*>(objects[i + 2]) + offset);
+    uint32 const size = objects.size();
+
+    if (i + 4 < size)
+        for (uint32 offset : { 0, 512, 1152, 1280, 1408, 1536, 2176, 2304, 2816, 3584, 3712 })
+            __builtin_prefetch(reinterpret_cast<char const*>(objects[i + 4]) + offset);
+
+    if (i + 3 < size)
+    {
+        objects[i + 3]->PrefetchUpdateFields();
+        if (Creature* creature = objects[i + 3]->ToCreature())
+            PrefetchCreatureBlocks(creature);
+    }
+
+    if (i + 2 < size)
+        if (Creature* creature = objects[i + 2]->ToCreature())
+            PrefetchCreatureTargets(creature);
 
-    if (i + 1 < objects.size())
-        objects[i + 1]->PrefetchUpdateFields();
+    if (i + 1 < size)
+        if (Creature* creature = objects[i + 1]->ToCreature())
+            PrefetchCreatureAuraEffects(creature);
 }
 
