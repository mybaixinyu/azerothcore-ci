     return &instance;
 }
 
+// Locales named by Locale.LoadOnly plus enUS; every locale when it is empty or names an unknown locale.
+static uint32 GetLoadedLocaleMask()
+{
+    uint32 const allLocales = (1u << TOTAL_LOCALES) - 1;
+    std::string const names = sConfigMgr->GetOption<std::string>("Locale.LoadOnly", "");
+    if (names.empty())
+        return allLocales;
+
+    uint32 mask = 1u << LOCALE_enUS;
+    for (std::string_view name : Acore::Tokenize(names, ',', false))
+    {
+        uint32 i = 0;
+        while (i < TOTAL_LOCALES && !(localeNames[i] && name == localeNames[i]))
+            ++i;
+
+        if (i == TOTAL_LOCALES)
+        {
+            LOG_ERROR("server.loading", "Locale.LoadOnly names unknown locale '{}', keeping all locales in memory.", name);
+            return allLocales;
+        }
+
+        mask |= 1u << i;
+    }
+
+    LOG_INFO("server.loading", "Locale.LoadOnly = {}: other locales are not kept in memory.", names);
+    return mask;
+}
