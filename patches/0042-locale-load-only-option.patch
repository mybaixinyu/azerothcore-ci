+#
+#    Locale.LoadOnly
+#        Description: Comma-separated database locales to keep in memory (enUS is always kept),
+#                     for example "zhCN". The other locales are read at startup and dropped.
+#                     Clients of a dropped locale see English text, and chat links carrying a
+#                     name in a dropped locale can fail link validation. An unknown locale
+#                     name logs an error and keeps all locales. Needs a restart to change.
+#        Default:     "" - (Keep all locales)
+
+Locale.LoadOnly = ""
