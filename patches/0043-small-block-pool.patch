+
+// Small-block pool in front of global operator new and delete, macOS only.
+//
+// Why: xzone malloc splits its partial chunk lists per CPU cluster under contention. With hundreds of
+// thousands of small allocations per second, part of them freed on another thread, free slots pile up on
+// the list of a cluster that does not consume them while other clusters open new chunks.
+// Blocks served here never reach those lists.
+//
+// Shape: a per-thread LIFO cache needs no atomics. A full cache hands a batch to a per-size shared list and
+// an empty one takes a batch from it, then takes cold blocks, and only then carves a slab. A freed block is
+// zeroed, like xzone malloc does below 1 KiB, so a read of uninitialized memory sees what it saw before.
+// Aging follows sync.Pool: blocks idle for a whole epoch move from thread cache to shared list to cold state,
+// and a slab whose blocks are all cold goes back to the system. A slab with one live block stays, but its
+// free blocks are reused before any new slab is carved.
+//
+// Everything the pool does not serve goes to malloc from the single call in SystemNew. xzone malloc derives an
+// untyped allocation's type from its caller's return address and keeps each type's blocks in its own bucket, so
+// the same object made at two call sites, a creature at grid load and at respawn, lands in two buckets, and the
+// slots a dead grid creature leaves are only reused by later grid loads. One call site makes one type per size.
+//
+// AC_SMALL_BLOCK_POOL=0 in the environment turns the pool off, for example for MallocStackLogging, since
+// the system allocator's tools do not see pool blocks. The region shows in vmmap with VM tag 240.
+
+#include "SmallBlockPool.h"
+
+#ifdef AC_SMALL_BLOCK_POOL
+
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <mach/vm_statistics.h>
+#include <new>
+#include <os/lock.h>
+#include <pthread.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+namespace
+{
+    constexpr size_t MaxBlockSize = 256;
+    constexpr size_t Granule = 16;
+    constexpr size_t ClassCount = MaxBlockSize / Granule + 1;
+    constexpr uint32_t CacheCapacity = 256;
+    constexpr uint32_t BatchSize = 128;
+    constexpr size_t SlabSize = 64 * 1024;
+    constexpr size_t RegionSize = size_t(16) << 30;
+    constexpr size_t SlabCount = RegionSize / SlabSize;
+    constexpr size_t BitmapWords = SlabSize / Granule / 64;
+
+    struct ThreadCache
+    {
+        uint32_t epoch;
+        uint32_t count[ClassCount];
+        uint32_t low[ClassCount];
+        char* bump[ClassCount];
+        char* bumpEnd[ClassCount];
+        void* blocks[ClassCount][CacheCapacity];
+    };
+
+    struct SharedList
+    {
+        os_unfair_lock lock = OS_UNFAIR_LOCK_INIT;
+        void* top = nullptr;
+        uint64_t batches = 0;
+        uint64_t low = 0;
+    };
+
+    struct ColdList
+    {
+        os_unfair_lock lock = OS_UNFAIR_LOCK_INIT;
+        uint32_t head = 0; // slab index + 1
+    };
+
+    char* s_base = nullptr;
+    uint8_t* s_slabClass = nullptr;
+    uint64_t* s_coldBits = nullptr;
+    uint16_t* s_coldCount = nullptr;
+    uint32_t* s_coldNext = nullptr;
+    uint32_t* s_coldPrev = nullptr;
+    uint32_t* s_freeSlabs = nullptr;
+    uint32_t s_freeSlabCount = 0;
+    os_unfair_lock s_freeSlabLock = OS_UNFAIR_LOCK_INIT;
+    std::atomic<uint64_t> s_nextSlab{0};
+    std::atomic<uint32_t> s_epoch{0};
+    std::atomic<bool> s_warned{false};
+    SharedList s_shared[ClassCount];
+    ColdList s_cold[ClassCount];
+    pthread_key_t s_threadKey;
+    pthread_once_t s_once = PTHREAD_ONCE_INIT;
+
+    ThreadCache* const NoCache = reinterpret_cast<ThreadCache*>(uintptr_t(1));
+    thread_local ThreadCache* t_cache = nullptr;
+
+    void WarnOnce(char const* message)
+    {
+        if (!s_warned.exchange(true, std::memory_order_relaxed))
+        {
+            ssize_t ignored = write(STDERR_FILENO, message, strlen(message));
+            (void)ignored;
+        }
+    }
+
+    template <typename T>
+    T* MapTable(size_t count)
+    {
+        void* p = mmap(nullptr, count * sizeof(T), PROT_READ | PROT_WRITE, MAP_ANON | MAP_PRIVATE, -1, 0);
+        return p == MAP_FAILED ? nullptr : static_cast<T*>(p);
+    }
+
+    inline void*& NextInBatch(void* block) { return static_cast<void**>(block)[0]; }
+    inline void*& NextBatch(void* block) { return static_cast<void**>(block)[1]; }
+
+    void PushBatch(size_t cls, void* head)
+    {
+        SharedList& list = s_shared[cls];
+        os_unfair_lock_lock(&list.lock);
+        NextBatch(head) = list.top;
+        list.top = head;
+        ++list.batches;
+        os_unfair_lock_unlock(&list.lock);
+    }
+
+    void* PopBatch(size_t cls)
+    {
+        SharedList& list = s_shared[cls];
+        os_unfair_lock_lock(&list.lock);
+        void* head = list.top;
+        if (head)
+        {
+            list.top = NextBatch(head);
+            --list.batches;
+            if (list.batches < list.low)
+                list.low = list.batches;
+        }
+        os_unfair_lock_unlock(&list.lock);
+        return head;
+    }
+
+    // Hands the oldest k cached blocks of a class to the shared list.
+    void FlushOldest(ThreadCache* cache, size_t cls, uint32_t k)
+    {
+        void** blocks = cache->blocks[cls];
+        for (uint32_t i = 0; i + 1 < k; ++i)
+            NextInBatch(blocks[i]) = blocks[i + 1];
+        NextInBatch(blocks[k - 1]) = nullptr;
+        NextBatch(blocks[0]) = nullptr;
+        PushBatch(cls, blocks[0]);
+        cache->count[cls] -= k;
+        memmove(blocks, blocks + k, cache->count[cls] * sizeof(void*));
+    }
+
+    void ThreadExit(void* value)
+    {
+        ThreadCache* cache = static_cast<ThreadCache*>(value);
+        for (size_t cls = 1; cls < ClassCount; ++cls)
+        {
+            if (cache->count[cls])
+                FlushOldest(cache, cls, cache->count[cls]);
+            for (char* p = cache->bump[cls]; p && p < cache->bumpEnd[cls]; p += cls * Granule)
+                PushBatch(cls, p);
+        }
+        t_cache = NoCache;
+        munmap(cache, sizeof(ThreadCache));
+    }
+
+    void InitOnce()
+    {
+        char const* setting = getenv("AC_SMALL_BLOCK_POOL");
+        if (setting && setting[0] == '0')
+            return;
+
+        void* region = mmap(nullptr, RegionSize, PROT_READ | PROT_WRITE, MAP_ANON | MAP_PRIVATE, VM_MAKE_TAG(240), 0);
+        s_slabClass = MapTable<uint8_t>(SlabCount);
+        s_coldBits = MapTable<uint64_t>(SlabCount * BitmapWords);
+        s_coldCount = MapTable<uint16_t>(SlabCount);
+        s_coldNext = MapTable<uint32_t>(SlabCount);
+        s_coldPrev = MapTable<uint32_t>(SlabCount);
+        s_freeSlabs = MapTable<uint32_t>(SlabCount);
+        if (region == MAP_FAILED || !s_slabClass || !s_coldBits || !s_coldCount || !s_coldNext || !s_coldPrev || !s_freeSlabs || pthread_key_create(&s_threadKey, ThreadExit))
+        {
+            WarnOnce("SmallBlockPool: could not map its region, using the system allocator.\n");
+            return;
+        }
+        s_base = static_cast<char*>(region);
+    }
+
+    __attribute__((noinline)) ThreadCache* CreateCache()
+    {
+        pthread_once(&s_once, InitOnce);
+        if (!s_base)
+            return t_cache = NoCache;
+
+        void* p = mmap(nullptr, sizeof(ThreadCache), PROT_READ | PROT_WRITE, MAP_ANON | MAP_PRIVATE, VM_MAKE_TAG(240), 0);
+        if (p == MAP_FAILED)
+            return t_cache = NoCache;
+
+        pthread_setspecific(s_threadKey, p);
+        return t_cache = static_cast<ThreadCache*>(p);
+    }
+
+    // Moves up to one batch of cold blocks into the cache. Cold blocks are entirely zero.
+    void* TakeCold(ThreadCache* cache, size_t cls)
+    {
+        ColdList& list = s_cold[cls];
+        os_unfair_lock_lock(&list.lock);
+        void* first = nullptr;
+        if (uint32_t slabPlusOne = list.head)
+        {
+            size_t slab = slabPlusOne - 1;
+            uint64_t* bits = s_coldBits + slab * BitmapWords;
+            uint32_t got = 0;
+            for (size_t w = 0; w < BitmapWords && got < BatchSize; ++w)
+            {
+                while (bits[w] && got < BatchSize)
+                {
+                    size_t index = w * 64 + size_t(__builtin_ctzll(bits[w]));
+                    bits[w] &= bits[w] - 1;
+                    void* block = s_base + slab * SlabSize + index * cls * Granule;
+                    if (!first)
+                        first = block;
+                    else
+                        cache->blocks[cls][got - 1] = block;
+                    ++got;
+                }
+            }
+            s_coldCount[slab] = uint16_t(s_coldCount[slab] - got);
+            if (!s_coldCount[slab])
+            {
+                list.head = s_coldNext[slab];
+                if (list.head)
+                    s_coldPrev[list.head - 1] = 0;
+                s_coldNext[slab] = 0;
+            }
+            cache->count[cls] = got - 1;
+        }
+        os_unfair_lock_unlock(&list.lock);
+        return first;
+    }
+
+    __attribute__((noinline)) void* Refill(ThreadCache* cache, size_t cls)
+    {
+        cache->low[cls] = 0;
+
+        if (void* block = PopBatch(cls))
+        {
+            void* first = block;
+            uint32_t n = 0;
+            for (void* p = block; p;)
+            {
+                void* next = NextInBatch(p);
+                NextInBatch(p) = nullptr;
+                NextBatch(p) = nullptr;
+                if (p != first)
+                {
+                    if (n < CacheCapacity)
+                        cache->blocks[cls][n++] = p;
+                    else
+                        PushBatch(cls, p);
+                }
+                p = next;
+            }
+            cache->count[cls] = n;
+            return first;
+        }
+
+        if (void* block = TakeCold(cache, cls))
+            return block;
+
+        if (cache->bump[cls] == cache->bumpEnd[cls])
+        {
+            size_t slab;
+            os_unfair_lock_lock(&s_freeSlabLock);
+            if (s_freeSlabCount)
+            {
+                slab = s_freeSlabs[--s_freeSlabCount];
+                os_unfair_lock_unlock(&s_freeSlabLock);
+            }
+            else
+            {
+                os_unfair_lock_unlock(&s_freeSlabLock);
+                slab = s_nextSlab.fetch_add(1, std::memory_order_relaxed);
+                if (slab >= SlabCount)
+                {
+                    WarnOnce("SmallBlockPool: region exhausted, using the system allocator for new blocks.\n");
+                    return nullptr;
+                }
+            }
+            s_slabClass[slab] = uint8_t(cls);
+            cache->bump[cls] = s_base + slab * SlabSize;
+            cache->bumpEnd[cls] = cache->bump[cls] + SlabSize / (cls * Granule) * (cls * Granule);
+        }
+
+        void* block = cache->bump[cls];
+        cache->bump[cls] += cls * Granule;
+        return block;
+    }
+
+    // Hands blocks unused since the last epoch to the shared list. Runs on the owning thread.
+    __attribute__((noinline)) void AgeCache(ThreadCache* cache, uint32_t epoch)
+    {
+        cache->epoch = epoch;
+        for (size_t cls = 1; cls < ClassCount; ++cls)
+        {
+            uint32_t k = cache->low[cls] < cache->count[cls] ? cache->low[cls] : cache->count[cls];
+            if (k)
+                FlushOldest(cache, cls, k);
+            cache->low[cls] = cache->count[cls];
+        }
+    }
+
+    void MarkCold(size_t cls, char* block)
+    {
+        size_t offset = size_t(block - s_base);
+        size_t slab = offset / SlabSize;
+        size_t index = (offset - slab * SlabSize) / (cls * Granule);
+        uint32_t capacity = uint32_t(SlabSize / (cls * Granule));
+
+        ColdList& list = s_cold[cls];
+        os_unfair_lock_lock(&list.lock);
+        s_coldBits[slab * BitmapWords + index / 64] |= uint64_t(1) << (index % 64);
+        if (!s_coldCount[slab])
+        {
+            s_coldNext[slab] = list.head;
+            s_coldPrev[slab] = 0;
+            if (list.head)
+                s_coldPrev[list.head - 1] = uint32_t(slab) + 1;
+            list.head = uint32_t(slab) + 1;
+        }
+
+        if (++s_coldCount[slab] < capacity)
+        {
+            os_unfair_lock_unlock(&list.lock);
+            return;
+        }
+
+        // Every block of this slab is cold, so nobody holds one: give the memory back.
+        uint32_t next = s_coldNext[slab];
+        uint32_t prev = s_coldPrev[slab];
+        if (prev)
+            s_coldNext[prev - 1] = next;
+        else
+            list.head = next;
+        if (next)
+            s_coldPrev[next - 1] = prev;
+        s_coldNext[slab] = 0;
+        s_coldPrev[slab] = 0;
+        s_coldCount[slab] = 0;
+        memset(s_coldBits + slab * BitmapWords, 0, BitmapWords * sizeof(uint64_t));
+        os_unfair_lock_unlock(&list.lock);
+
+        if (mmap(s_base + slab * SlabSize, SlabSize, PROT_READ | PROT_WRITE, MAP_ANON | MAP_PRIVATE | MAP_FIXED, VM_MAKE_TAG(240), 0) == MAP_FAILED)
+        {
+            // The old pages are still mapped and hold zeros; only the release failed.
+            memset(s_base + slab * SlabSize, 0, SlabSize);
+        }
+
+        os_unfair_lock_lock(&s_freeSlabLock);
+        s_freeSlabs[s_freeSlabCount++] = uint32_t(slab);
+        os_unfair_lock_unlock(&s_freeSlabLock);
+    }
+
+    inline void* Allocate(size_t size)
+    {
+        ThreadCache* cache = t_cache;
+        if (!cache)
+            cache = CreateCache();
+        if (cache == NoCache)
+            return nullptr;
+
+        // The same rounding as xzone malloc's classes, so a block keeps the slack it always had
+        size_t cls = size <= 128 ? (size ? (size + Granule - 1) / Granule : 1) : (size + 31) / 32 * 2;
+        if (uint32_t n = cache->count[cls])
+        {
+            cache->count[cls] = --n;
+            if (n < cache->low[cls])
+                cache->low[cls] = n;
+            return cache->blocks[cls][n];
+        }
+        return Refill(cache, cls);
+    }
+
+    inline bool Deallocate(void* block)
+    {
+        if (!s_base || uintptr_t(block) - uintptr_t(s_base) >= RegionSize)
+            return false;
+
+        size_t cls = s_slabClass[size_t(static_cast<char*>(block) - s_base) / SlabSize];
+        memset(block, 0, cls * Granule);
+
+        ThreadCache* cache = t_cache;
+        if (!cache)
+            cache = CreateCache();
+        if (cache == NoCache)
+        {
+            PushBatch(cls, block);
+            return true;
+        }
+
+        uint32_t epoch = s_epoch.load(std::memory_order_relaxed);
+        if (epoch != cache->epoch)
+            AgeCache(cache, epoch);
+
+        if (cache->count[cls] == CacheCapacity)
+            FlushOldest(cache, cls, BatchSize);
+        cache->blocks[cls][cache->count[cls]++] = block;
+        return true;
+    }
+
+    // Never inlined, and malloc is not its tail call: the one return address malloc sees is in here.
+    __attribute__((noinline)) void* SystemNew(size_t size)
+    {
+        for (;;)
+        {
+            if (void* p = malloc(size ? size : 1))
+                return p;
+            std::new_handler handler = std::get_new_handler();
+            if (!handler)
+                throw std::bad_alloc();
+            handler();
+        }
+    }
+
+    inline void* PoolNew(size_t size)
+    {
+        if (size <= MaxBlockSize)
+            if (void* p = Allocate(size))
+                return p;
+        return SystemNew(size);
+    }
+
+    inline void* PoolNewNoThrow(size_t size) noexcept
+    {
+        if (size <= MaxBlockSize)
+            if (void* p = Allocate(size))
+                return p;
+        try
+        {
+            return SystemNew(size);
+        }
+        catch (...)
+        {
+            return nullptr;
+        }
+    }
+
+    inline void PoolDelete(void* block) noexcept
+    {
+        if (!Deallocate(block))
+            free(block);
+    }
+}
+
+void SmallBlockPool::Age()
+{
+    if (!s_base)
+        return;
+
+    for (size_t cls = 1; cls < ClassCount; ++cls)
+    {
+        SharedList& list = s_shared[cls];
+        os_unfair_lock_lock(&list.lock);
+        uint64_t idle = list.low < list.batches ? list.low : list.batches;
+        uint64_t keep = list.batches - idle;
+        void* oldest = nullptr;
+        if (idle)
+        {
+            void** link = &list.top;
+            for (uint64_t i = 0; i < keep; ++i)
+                link = &NextBatch(*link);
+            oldest = *link;
+            *link = nullptr;
+            list.batches = keep;
+        }
+        list.low = list.batches;
+        os_unfair_lock_unlock(&list.lock);
+
+        while (oldest)
+        {
+            void* nextBatch = NextBatch(oldest);
+            for (void* p = oldest; p;)
+            {
+                void* next = NextInBatch(p);
+                NextInBatch(p) = nullptr;
+                NextBatch(p) = nullptr;
+                MarkCold(cls, static_cast<char*>(p));
+                p = next;
+            }
+            oldest = nextBatch;
+        }
+    }
+
+    s_epoch.fetch_add(1, std::memory_order_relaxed);
+}
+
+#ifndef SMALL_BLOCK_POOL_NO_OPERATORS
+void* operator new(size_t size) { return PoolNew(size); }
+void* operator new[](size_t size) { return PoolNew(size); }
+void* operator new(size_t size, std::nothrow_t const&) noexcept { return PoolNewNoThrow(size); }
+void* operator new[](size_t size, std::nothrow_t const&) noexcept { return PoolNewNoThrow(size); }
+void operator delete(void* block) noexcept { PoolDelete(block); }
+void operator delete[](void* block) noexcept { PoolDelete(block); }
+void operator delete(void* block, std::nothrow_t const&) noexcept { PoolDelete(block); }
+void operator delete[](void* block, std::nothrow_t const&) noexcept { PoolDelete(block); }
+void operator delete(void* block, size_t) noexcept { PoolDelete(block); }
+void operator delete[](void* block, size_t) noexcept { PoolDelete(block); }
+#endif
+
+#endif
