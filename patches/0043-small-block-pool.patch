+
+// The pool replaces global operator new and delete for blocks up to 256 bytes on macOS.
+// Sanitizer builds keep the system allocator so their own checks stay in force.
+#if defined(__APPLE__) && !defined(__SANITIZE_THREAD__) && !defined(__SANITIZE_ADDRESS__)
+#if defined(__has_feature)
+#if !__has_feature(thread_sanitizer) && !__has_feature(address_sanitizer)
