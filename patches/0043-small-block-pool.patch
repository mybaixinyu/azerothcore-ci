+#else
+#define AC_SMALL_BLOCK_POOL 1
+#endif
+#endif
+
+namespace SmallBlockPool
+{
+#ifdef AC_SMALL_BLOCK_POOL
+    // Starts a new aging epoch. Call periodically from one thread.
+    void Age();
+#else
+    inline void Age() { }
+#endif
+}
+
+#endif
