     //! garbage and the following dereference faults. Walk a snapshot of the guids instead
     //! and look each object up again - the store, not a pointer we cached, is the authority
     //! on whether the object still exists by the time we reach it.
+    //!
+    //! Next to each guid the snapshot keeps two addresses, used only as prefetch hints and never read through: where
+    //! the store keeps the entry, and the object. Either may be stale by the time it is used, which costs nothing, as
+    //! a prefetch does not fault and the walk still asks the store.
     template<class T>
-    static std::vector<ObjectGuid> Snapshot(std::unordered_map<ObjectGuid, T*> const& objectMap)
+    class Snapshot
     {
-        std::vector<ObjectGuid> guids;
-        guids.reserve(objectMap.size());
-        for (auto const& p : objectMap)
-            guids.push_back(p.first);
+    public:
+        explicit Snapshot(std::unordered_map<ObjectGuid, T*> const& objectMap)
+        {
+            _entries.reserve(objectMap.size());
+            for (auto const& p : objectMap)
+                _entries.push_back({ p.first, reinterpret_cast<uintptr_t>(&p), reinterpret_cast<uintptr_t>(p.second) });
+
+            // Member offsets are the same for every T; take them from an object that is alive now.
+            for (Entry const& entry : _entries)
+            {
+                if (!entry.object)
+                    continue;
+
+                _fields = reinterpret_cast<T const*>(entry.object)->AIStateAddresses();
+                for (uintptr_t& field : _fields)
+                    field -= entry.object;
+
+                _haveFields = true;
+                break;
+            }
+        }
+
+        [[nodiscard]] size_t Size() const { return _entries.size(); }
+        [[nodiscard]] ObjectGuid const& Guid(size_t i) const { return _entries[i].guid; }
+
+        //! The store entry's hash and key, which a lookup reads, and its link, which the lookup of the next entry reads
+        //! (libc++ keeps them in the 16 bytes before the key and value; a different layout only weakens the hint).
+        void PrefetchEntry(size_t i) const
+        {
+            __builtin_prefetch(reinterpret_cast<void const*>(_entries[i].entry - 16));
+            __builtin_prefetch(reinterpret_cast<void const*>(_entries[i].entry + 15));
+        }
 
-        return guids;
+        //! The fields the walk's checks read and the AI pointer.
+        void PrefetchObject(size_t i) const
+        {
+            if (!_haveFields || !_entries[i].object)
+                return;
+
+            for (uintptr_t field : _fields)
+                __builtin_prefetch(reinterpret_cast<void const*>(_entries[i].object + field));
+        }
+
+    private:
+        struct Entry
+        {
+            ObjectGuid guid;
+            uintptr_t entry;
+            uintptr_t object;
+        };
+
+        std::vector<Entry> _entries;
+        decltype(std::declval<T const&>().AIStateAddresses()) _fields{};
+        bool _haveFields = false;
+    };
+
+    //! Memory hints only: visiting an object mostly waits on cache misses for the store entry, the object and its AI.
+    //! The entry is prefetched EntryAhead steps early and the object ObjectAhead steps early, from the snapshot's
+    //! addresses; the AI NearAhead steps early, through a fresh lookup that by then hits the cache. What the walk
+    //! calls, and in which order, is unchanged.
+    template<class T>
+    void PrefetchAhead(Snapshot<T> const& snapshot, size_t i) const
+    {
+        if (i + EntryAhead < snapshot.Size())
+            snapshot.PrefetchEntry(i + EntryAhead);
+        if (i + ObjectAhead < snapshot.Size())
+            snapshot.PrefetchObject(i + ObjectAhead);
+        if (i + NearAhead < snapshot.Size())
+            if (T* object = Find<T>(snapshot.Guid(i + NearAhead)))
+                if (auto* ai = object->AI())
+                    __builtin_prefetch(ai);
     }
 
+    template<class T>
+    T* Find(ObjectGuid const& guid) const
+    {
+        if constexpr (std::is_same_v<T, Creature>)
+            return _map->GetCreature(guid);
+        else
+            return _map->GetGameObject(guid);
+    }
+
+    static constexpr size_t NearAhead = 4;
+    static constexpr size_t ObjectAhead = 8;
+    static constexpr size_t EntryAhead = 12;
+
