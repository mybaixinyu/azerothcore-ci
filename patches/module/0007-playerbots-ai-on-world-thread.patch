+std::string RunRemoteCommand(std::string const& request)
+{
+    auto answer = std::make_shared<std::promise<std::string>>();
+    std::future<std::string> result = answer->get_future();
+    PlayerbotThreadContext::RunOnWorldThread([answer, request]()
