+        // Rethrown on this session's thread, which handles it as before instead of the world thread dying
+        try
+        {
+            answer->set_value(RandomPlayerbotMgr::instance().HandleRemoteCommand(request));
+        }
+        catch (...)
+        {
+            answer->set_exception(std::current_exception());
+        }
+    });
+
+    // The world stops updating at shutdown
+    if (result.wait_for(std::chrono::seconds(10)) != std::future_status::ready)
+        return "timeout";
+
+    return result.get();
+}
