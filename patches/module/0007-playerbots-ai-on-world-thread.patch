diff --git a/src/Script/WorldThr/PlayerbotThreadContext.cpp b/src/Script/WorldThr/PlayerbotThreadContext.cpp
new file mode 100644
index 0000000..6e83382
--- /dev/null
+++ b/src/Script/WorldThr/PlayerbotThreadContext.cpp
@@ -0,0 +1,51 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+#include "PlayerbotThreadContext.h"
+#include "Log.h"
+#include <atomic>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace
+{
+    std::atomic<std::thread::id> worldThread{};
+    std::mutex postedWorkLock;
+    std::vector<std::function<void()>> postedWork;
+}
+
+void PlayerbotThreadContext::SetWorldThread()
+{
+    std::thread::id const self = std::this_thread::get_id();
+    std::thread::id const previous = worldThread.exchange(self, std::memory_order_relaxed);
+    if (previous != std::thread::id() && previous != self)
+        LOG_ERROR("playerbots", "The world update ran on a different thread than before");
+}
+
+bool PlayerbotThreadContext::IsWorldThread()
+{
+    return worldThread.load(std::memory_order_relaxed) == std::this_thread::get_id();
+}
+
+void PlayerbotThreadContext::RunOnWorldThread(std::function<void()> work)
+{
+    std::lock_guard<std::mutex> lock(postedWorkLock);
+    postedWork.push_back(std::move(work));
+}
+
+void PlayerbotThreadContext::RunPostedWork()
+{
+    std::vector<std::function<void()>> work;
+    {
+        std::lock_guard<std::mutex> lock(postedWorkLock);
+        work.swap(postedWork);
+    }
+
+    // Work may post more work; that runs on the next update
+    for (std::function<void()>& item : work)
+        item();
+}
