@@ -549,4 +550,35 @@ private:
     ObjectGuid m_botGuid;
 };
 
+// Bot code that changes world-thread state and acts on the outcome at once (joining a group, turning in a
+// charter): run as one step on the world thread, where a client's packet for it would be handled too
+class BotWorldThreadTask : public PlayerbotOperation
+{
+public:
+    BotWorldThreadTask(ObjectGuid botGuid, std::string name, std::function<void(Player*, PlayerbotAI*)> task)
+        : m_botGuid(botGuid), m_name(std::move(name)), m_task(std::move(task))
+    {
+    }
+
+    bool Execute() override
+    {
+        Player* bot = ObjectAccessor::FindPlayer(m_botGuid);
+        PlayerbotAI* botAI = bot ? PlayerbotsMgr::instance().GetPlayerbotAI(bot) : nullptr;
+        if (!botAI)
+            return false;
+
+        m_task(bot, botAI);
+        return true;
+    }
+
+    ObjectGuid GetBotGuid() const override { return m_botGuid; }
+    std::string GetName() const override { return m_name; }
+    bool IsValid() const override { return ObjectAccessor::FindPlayer(m_botGuid) != nullptr; }
+
+private:
+    ObjectGuid m_botGuid;
+    std::string m_name;
+    std::function<void(Player*, PlayerbotAI*)> m_task;
+};
+
 #endif
