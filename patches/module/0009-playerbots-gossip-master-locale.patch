+// What the bot tells its master is read in the master's client language, not the bot's session one
+static LocaleConstant MasterLocale(Player* master)
+{
+    return master && master->GetSession() ? master->GetSession()->GetSessionDbLocaleIndex() : DEFAULT_LOCALE;
+}
+
+// A gossip option's text in a locale, picked the way GossipMenu::AddMenuItem picks it
+static std::string GossipOptionText(GossipMenuItems const& option, LocaleConstant locale)
+{
+    std::string text;
+    if (BroadcastText const* broadcast = sObjectMgr->GetBroadcastText(option.OptionBroadcastTextID))
+    {
+        ObjectMgr::GetLocaleString(broadcast->MaleText, locale, text);
+        return text;
+    }
+
+    text = option.OptionText;
+    if (locale != DEFAULT_LOCALE)
+        if (GossipMenuItemsLocale const* optionLocale =
+                sObjectMgr->GetGossipMenuItemsLocale(MAKE_PAIR32(option.MenuID, option.OptionID)))
+            ObjectMgr::GetLocaleString(optionLocale->OptionText, locale, text);
+
+    return text;
+}
+
+// The menu was built in the bot's locale. Re-read an item in the master's when it came from the menu's database
+// options: same option id and the same text in the bot's locale. Items a script added keep their text.
+static std::string LocalizedMenuItem(GossipMenu const& menu, uint32 itemId, GossipMenuItem const& item,
+                                     LocaleConstant locale)
+{
+    if (locale == menu.GetLocale())
+        return item.Message;
+
+    GossipMenuItemsMapBounds options = sObjectMgr->GetGossipMenuItemsMapBounds(menu.GetMenuId());
+    for (auto itr = options.first; itr != options.second; ++itr)
+    {
+        if (itr->second.OptionID != itemId || GossipOptionText(itr->second, menu.GetLocale()) != item.Message)
+            continue;
+
+        std::string text = GossipOptionText(itr->second, locale);
+        return text.empty() ? item.Message : text;
+    }
+
+    return item.Message;
+}
