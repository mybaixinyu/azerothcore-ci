+    // The command reads bots that the world and map threads change; the world thread runs while no map updates
+    std::string AnswerOnWorldThread(std::string const& request)
+    {
+        auto answer = std::make_shared<std::promise<std::string>>();
+        std::future<std::string> result = answer->get_future();
+        if (!PlayerbotWorldThreadProcessor::instance().QueueOperation(
+                std::make_unique<RemoteCommandOperation>(request, answer)))
+            return "busy";
+
+        if (result.wait_for(std::chrono::seconds(5)) != std::future_status::ready)
+            return "timeout";
+
+        try
+        {
+            return result.get();
+        }
+        catch (std::future_error const&)
+        {
+            // Dropped unanswered: the queue was cleared on shutdown, or the command threw
+            return "failed";
+        }
+    }
+}
