+// Logs a bot out on the world thread, where the core logs players out. The holder is found again when it runs,
+// since a master's manager may be gone by then.
+class LogoutPlayerBotOperation : public PlayerbotOperation
+{
+public:
+    LogoutPlayerBotOperation(ObjectGuid botGuid, ObjectGuid masterGuid) : m_botGuid(botGuid), m_masterGuid(masterGuid)
+    {
+    }
+
+    bool Execute() override
+    {
+        PlayerbotHolder* holder = &RandomPlayerbotMgr::instance();
+        if (!m_masterGuid.IsEmpty())
+        {
+            Player* master = ObjectAccessor::FindConnectedPlayer(m_masterGuid);
+            holder = master ? PlayerbotsMgr::instance().GetPlayerbotMgr(master) : nullptr;
+        }
+
+        if (!holder || !holder->GetPlayerBot(m_botGuid))
+            return false;
+
+        holder->LogoutPlayerBot(m_botGuid);
+        return true;
+    }
+
+    ObjectGuid GetBotGuid() const override { return m_botGuid; }
+    std::string GetName() const override { return "LogoutPlayerBot"; }
+    // A bot teleporting far is out of the world but still logged in
+    bool IsValid() const override { return ObjectAccessor::FindConnectedPlayer(m_botGuid) != nullptr; }
+
+private:
+    ObjectGuid m_botGuid;
+    ObjectGuid m_masterGuid;
+};
