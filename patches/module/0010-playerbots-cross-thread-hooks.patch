+#include "PlayerbotThreadContext.h"
+#include "Log.h"
+#include "World.h"
+#include <atomic>
+#include <thread>
+
+namespace
+{
+    std::atomic<std::thread::id> worldThread{};
+}
+
+void PlayerbotThreadContext::SetWorldThread()
+{
+    std::thread::id const self = std::this_thread::get_id();
+    std::thread::id const previous = worldThread.exchange(self, std::memory_order_relaxed);
+    if (previous != std::thread::id() && previous != self)
+        LOG_ERROR("playerbots", "The world update ran on a different thread than before");
+}
+
+bool PlayerbotThreadContext::IsWorldThread()
+{
+    return worldThread.load(std::memory_order_relaxed) == std::this_thread::get_id();
+}
+
+bool PlayerbotThreadContext::OtherMapsMayRun()
+{
+    return sWorld->getIntConfig(CONFIG_NUMTHREADS) > 1 && !IsWorldThread();
+}
