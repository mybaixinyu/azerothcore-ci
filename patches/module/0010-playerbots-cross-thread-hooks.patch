+// the bots on its own map. The world thread may touch any bot, and so may every thread when there is one worker.
+namespace PlayerbotThreadContext
+{
+    // Called from the world hooks
+    void SetWorldThread();
+    bool IsWorldThread();
+
+    // True when another map may be updating at the same time as the calling thread
+    bool OtherMapsMayRun();
+}
