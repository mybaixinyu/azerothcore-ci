diff --git a/src/Ai/Raid/RaidStateLock.cpp b/src/Ai/Raid/RaidStateLock.cpp
new file mode 100644
index 0000000..d29d759
--- /dev/null
+++ b/src/Ai/Raid/RaidStateLock.cpp
@@ -0,0 +1,29 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+#include "RaidStateLock.h"
+
+namespace
+{
+    struct RaidLock
+    {
+        uint32 mapId;
+        std::recursive_mutex mutex;
+    };
+
+    // Raids whose helper tables have no lock of their own: Karazhan, Hyjal Summit, Magtheridon's Lair, Tempest Keep,
+    // Black Temple, Zul'Aman, Ulduar, Ruby Sanctum
+    RaidLock raidLocks[] = {{532, {}}, {534, {}}, {544, {}}, {550, {}}, {564, {}}, {568, {}}, {603, {}}, {724, {}}};
+}
+
+std::unique_lock<std::recursive_mutex> RaidStateLock::Lock(uint32 mapId)
+{
+    for (RaidLock& raid : raidLocks)
+        if (raid.mapId == mapId)
+            return std::unique_lock<std::recursive_mutex>(raid.mutex);
+
+    return {};
+}
diff --git a/src/Ai/Raid/RaidStateLock.h b/src/Ai/Raid/RaidStateLock.h
new file mode 100644
index 0000000..c1192d3
--- /dev/null
+++ b/src/Ai/Raid/RaidStateLock.h
@@ -0,0 +1,22 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+#ifndef PLAYERBOTS_RAIDSTATELOCK_H
+#define PLAYERBOTS_RAIDSTATELOCK_H
+
+#include "Define.h"
+#include <mutex>
+
+// The helpers of some raids keep their per-instance state in tables shared by every instance of that raid, and two
+// instances can update on different map threads. Everything that reaches those tables runs under the raid's lock: the
+// bots' AI update on the raid's map and the raid's spell listener scripts.
+namespace RaidStateLock
+{
+    // Holds the lock of the raid on mapId, or nothing when that map's helpers need none
+    std::unique_lock<std::recursive_mutex> Lock(uint32 mapId);
+}
+
+#endif
