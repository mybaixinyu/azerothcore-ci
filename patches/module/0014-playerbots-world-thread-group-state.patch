diff --git a/src/Script/WorldThr/PlayerbotWorldThread.cpp b/src/Script/WorldThr/PlayerbotWorldThread.cpp
new file mode 100644
index 0000000..37885ee
--- /dev/null
+++ b/src/Script/WorldThr/PlayerbotWorldThread.cpp
@@ -0,0 +1,90 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+#include "PlayerbotWorldThread.h"
+#include "Group.h"
+#include "Log.h"
+#include "PlayerbotOperations.h"
+#include "PlayerbotThreadContext.h"
+#include "PlayerbotWorldThreadProcessor.h"
+
+namespace
+{
+    class WorldThreadTask : public PlayerbotOperation
+    {
+    public:
+        WorldThreadTask(std::string name, std::function<void()> task) : m_name(std::move(name)), m_task(std::move(task))
+        {
+        }
+
+        bool Execute() override
+        {
+            m_task();
+            return true;
+        }
+
+        std::string GetName() const override { return m_name; }
+
+    private:
+        std::string m_name;
+        std::function<void()> m_task;
+    };
+}
+
+void PlayerbotWorldThread::RunForBot(Player* bot, std::string name, std::function<void(Player*, PlayerbotAI*)> task)
+{
+    PlayerbotAI* botAI = PlayerbotsMgr::instance().GetPlayerbotAI(bot);
+    if (!PlayerbotThreadContext::OtherMapsMayRun())
+    {
+        task(bot, botAI);
+        return;
+    }
+
+    if (!PlayerbotWorldThreadProcessor::instance().QueueOperation(
+            std::make_unique<BotWorldThreadTask>(bot->GetGUID(), name, task)))
+    {
+        LOG_ERROR("playerbots", "{} for bot {} ran on its map thread instead", name, bot->GetName());
+        task(bot, botAI);
+    }
+}
+
+void PlayerbotWorldThread::Run(std::string name, std::function<void()> task)
+{
+    if (!PlayerbotThreadContext::OtherMapsMayRun())
+    {
+        task();
+        return;
+    }
+
+    if (!PlayerbotWorldThreadProcessor::instance().QueueOperation(std::make_unique<WorldThreadTask>(name, task)))
+    {
+        LOG_ERROR("playerbots", "{} ran on a map thread instead", name);
+        task();
+    }
+}
+
+void PlayerbotWorldThread::SetTargetIcon(Player* bot, Group* group, uint8 id, ObjectGuid targetGuid)
+{
+    if (!PlayerbotThreadContext::OtherMapsMayRun())
+    {
+        group->SetTargetIcon(id, bot->GetGUID(), targetGuid);
+        return;
+    }
+
+    // The core sets raid target icons on the world thread (MSG_RAID_TARGET_UPDATE)
+    RunForBot(bot, "SetTargetIcon",
+              [groupGuid = group->GetGUID(), id, targetGuid](Player* bot, PlayerbotAI* /*botAI*/)
+              {
+                  for (Group* current : {bot->GetGroup(), bot->GetOriginalGroup()})
+                  {
+                      if (current && current->GetGUID() == groupGuid)
+                      {
+                          current->SetTargetIcon(id, bot->GetGUID(), targetGuid);
+                          return;
+                      }
+                  }
+              });
+}
diff --git a/src/Script/WorldThr/PlayerbotWorldThread.h b/src/Script/WorldThr/PlayerbotWorldThread.h
new file mode 100644
index 0000000..9fd2962
--- /dev/null
+++ b/src/Script/WorldThr/PlayerbotWorldThread.h
@@ -0,0 +1,33 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+#ifndef PLAYERBOTS_PLAYERBOTWORLDTHREAD_H
+#define PLAYERBOTS_PLAYERBOTWORLDTHREAD_H
+
+#include "ObjectGuid.h"
+#include <functional>
+#include <string>
+
+class Group;
+class Player;
+class PlayerbotAI;
+
+// Changes the bot AI makes to state the core only changes on the world thread (groups, guilds, mail, the players
+// of other maps). They run right away when no other map can be updating, as they always did, and otherwise on the
+// world thread, up to about 50 ms later.
+namespace PlayerbotWorldThread
+{
+    // Dropped if the bot has logged out by the time the world thread gets to it
+    void RunForBot(Player* bot, std::string name, std::function<void(Player*, PlayerbotAI*)> task);
+
+    // Always runs, for work that must not be lost when the bot logs out, such as mail holding its items
+    void Run(std::string name, std::function<void()> task);
+
+    // Group::SetTargetIcon by the bot, applied only if the bot is still in that group
+    void SetTargetIcon(Player* bot, Group* group, uint8 id, ObjectGuid targetGuid);
+}
+
+#endif
