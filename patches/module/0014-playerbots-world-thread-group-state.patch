 #include "Playerbots.h"
 
+// Votes are group state, which the core changes on the world thread (CMSG_LOOT_ROLL). The core counts every call,
+// and the bot may decide again before a queued vote is counted, so there only a vote still missing is counted.
+static void CountRollVote(Player* bot, Group* group, ObjectGuid rollGuid, RollVote vote)
+{
+    if (!PlayerbotThreadContext::OtherMapsMayRun())
+    {
+        group->CountRollVote(bot->GetGUID(), rollGuid, vote);
+        return;
+    }
+
+    PlayerbotWorldThread::RunForBot(
+        bot, "CountRollVote",
+        [groupGuid = group->GetGUID(), rollGuid, vote](Player* bot, PlayerbotAI* /*botAI*/)
+        {
+            Group* group = bot->GetGroup();
+            if (!group || group->GetGUID() != groupGuid)
+                return;
+
+            // The roll CountRollVote finds
+            for (Roll const* roll : group->GetRolls())
+            {
+                if (roll->itemGUID != rollGuid || !roll->isValid())
+                    continue;
+
+                auto const voteItr = roll->playerVote.find(bot->GetGUID());
+                if (voteItr != roll->playerVote.end() && voteItr->second == NOT_EMITED_YET)
+                    group->CountRollVote(bot->GetGUID(), rollGuid, vote);
+                return;
+            }
+        });
+}
