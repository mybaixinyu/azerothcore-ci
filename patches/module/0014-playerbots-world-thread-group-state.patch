+// Mail to an online receiver is added to that player, who may be on another map, so it is delivered on the world
+// thread, where the core sends a client's mail (CMSG_SEND_MAIL). Delivery does not wait on the bot staying online:
+// the money and items have already left it.
+static void SendMail(MailDraft draft, CharacterDatabaseTransaction trans, Player* receiver, Player* bot)
+{
+    if (!PlayerbotThreadContext::OtherMapsMayRun())
+    {
+        draft.SendMailTo(trans, MailReceiver(receiver), MailSender(bot));
+        CharacterDatabase.CommitTransaction(trans);
+        return;
+    }
+
+    PlayerbotWorldThread::Run(
+        "SendMail",
+        [draft, trans, receiverGuid = receiver->GetGUID(), sender = MailSender(bot)]() mutable
+        {
+            draft.SendMailTo(trans, MailReceiver(receiverGuid.GetCounter()), sender);
+            CharacterDatabase.CommitTransaction(trans);
+        });
+}
