+// Every map thread reads these tables, so a missing level must read as empty instead of being inserted
+template <class T>
+static std::vector<T> const& LevelEntries(std::map<uint8, std::vector<T>> const& cache, uint8 level)
+{
+    static std::vector<T> const empty;
+    auto itr = cache.find(level);
+    return itr != cache.end() ? itr->second : empty;
