+
+// A state switch must drop the queued actions. The trigger and multiplier lists only change
+// when the strategies or what their Init functions read changed.
+void Engine::EnterState()
+{
+    // A custom strategy's text is edited through a single strategy object, with only the current engine rebuilt
+    if (strategiesChanged || hasCustomStrategy || builtFromInputs != BuildInputs())
+    {
+        Init();
+        return;
+    }
+
+    ClearQueue();
+
+    // Catches an Init function that starts reading something BuildInputs does not cover
+    if (++keptBuilds < KEPT_BUILDS_PER_CHECK)
+        return;
+
+    keptBuilds = 0;
+    if (MatchesFreshBuild())
+        return;
+
+    static std::atomic<bool> warned{false};
+    if (!warned.exchange(true))
+        LOG_ERROR("playerbots", "Engine for bot {} state {} had stale triggers after a state switch; rebuilding, later cases are not logged",
+                  botAI->GetBot()->GetName(), uint32(botAI->GetState()));
+
+    Init();
+}
+
+// Everything the InitTriggers and InitMultipliers functions read besides the strategy list
+uint64 Engine::BuildInputs()
+{
+    Player* bot = botAI->GetBot();
+    if (!bot)
+        return 0;
+
+    auto const mix = [](uint64 value)
+    {
+        value *= 0x9E3779B97F4A7C15ULL;
+        return value ^ (value >> 29);
+    };
+
+    uint8 const spec = bot->GetActiveSpec();
+
+    // Both maps are unordered, so the entries are summed
+    uint64 spells = 0;
+    for (auto const& [spellId, spell] : bot->GetSpellMap())
+        if (spell->State != PLAYERSPELL_REMOVED && spell->IsInSpec(spec))
+            spells += mix(spellId + 1);
+
+    // The spec tab counts talents pending removal and HasTalent does not, so that state is an input too
+    uint64 talents = 0;
+    for (auto const& [spellId, talent] : bot->GetTalentMap())
+        if (talent->IsInSpec(spec))
+            talents += mix(uint64(spellId) << 1 | uint64(talent->State == PLAYERSPELL_REMOVED));
+
+    uint64 const flags = uint64(bot->GetLevel()) | uint64(spec) << 8 | uint64(botAI->HasCheat(BotCheatMask::food)) << 16 |
+                         uint64(sPlayerbotAIConfig.RandomBotEmote) << 17 | uint64(sPlayerbotAIConfig.RandomBotTalk) << 18 |
+                         uint64(sPlayerbotAIConfig.EnableGreet) << 19;
+
+    return mix(spells) ^ mix(talents + 1) ^ mix(flags + 2);
+}
+
+bool Engine::MatchesFreshBuild()
+{
+    std::vector<TriggerNode*> freshTriggers;
+    std::vector<Multiplier*> freshMultipliers;
+    for (auto const& [name, strategy] : strategies)
+    {
+        strategy->InitMultipliers(freshMultipliers);
+        strategy->InitTriggers(freshTriggers);
+    }
+
+    bool matches = freshTriggers.size() == triggers.size() && freshMultipliers.size() == multipliers.size();
+
+    for (size_t i = 0; matches && i < triggers.size(); ++i)
+    {
+        std::vector<NextAction> kept = triggers[i]->getOwnHandlers();
+        std::vector<NextAction> fresh = freshTriggers[i]->getOwnHandlers();
+        matches = triggers[i]->getName() == freshTriggers[i]->getName() && kept.size() == fresh.size();
+        for (size_t j = 0; matches && j < kept.size(); ++j)
+            matches = kept[j].getName() == fresh[j].getName() && kept[j].getRelevance() == fresh[j].getRelevance();
+    }
+
+    for (size_t i = 0; matches && i < multipliers.size(); ++i)
+        matches = multipliers[i]->getName() == freshMultipliers[i]->getName();
+
+    for (TriggerNode* trigger : freshTriggers)
+        delete trigger;
+
+    for (Multiplier* multiplier : freshMultipliers)
+        delete multiplier;
+
+    return matches;
 }
 
