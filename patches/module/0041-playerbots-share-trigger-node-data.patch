index 7e28b708..0b326605 100644
--- a/src/Bot/Engine/Trigger/Trigger.cpp
+++ b/src/Bot/Engine/Trigger/Trigger.cpp
@@ -9,6 +9,40 @@
 #include "Event.h"
 #include "PlayerbotAI.h"
 
+#include <memory>
+#include <mutex>
+#include <shared_mutex>
+#include <unordered_map>
+
+TriggerNode::Shared const* TriggerNode::Intern(std::string const& name, std::vector<NextAction> handlers)
+{
+    static std::shared_mutex lock;
+    static std::unordered_map<std::string, std::unique_ptr<Shared const>> pool;
+
+    std::string key = name;
+    for (NextAction const& action : handlers)
+    {
+        key += '\0';
+        key += action.getName();
+        key += '\0';
+        float const relevance = action.getRelevance();
+        key.append(reinterpret_cast<char const*>(&relevance), sizeof(relevance));
+    }
+
+    {
+        std::shared_lock<std::shared_mutex> reader(lock);
+        auto const itr = pool.find(key);
+        if (itr != pool.end())
+            return itr->second.get();
+    }
+
+    std::unique_lock<std::shared_mutex> writer(lock);
+    std::unique_ptr<Shared const>& entry = pool[std::move(key)];
+    if (!entry)
+        entry = std::make_unique<Shared const>(Shared{name, std::move(handlers)});
+    return entry.get();
+}
+
 Trigger::Trigger(PlayerbotAI* botAI, std::string const name, int32 checkInterval)
     : AiNamedObject(botAI, name),
       checkInterval(checkInterval == 1 ? 1 : (checkInterval < 100 ? checkInterval * IN_MILLISECONDS : checkInterval)),
